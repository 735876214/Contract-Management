# ============================================================================
# CMS 单容器镜像（前后端一体）—— 仅生成「一个」容器即可完整运行
#
# 适用场景：
#   - 部署平台对容器数量有限制（只给一个容器配额），或
#   - 多容器长时间运行后易被平台按配额逐个回收 / 终止。
#   单容器把「NestJS 后端 + PostgreSQL」与「nginx 前端静态托管 + /api 反代」
#   合并进同一个镜像：对外只暴露一个端口，内部 nginx 把 /api 反代到
#   同容器的 127.0.0.1:3000，从而减少资源占用与容器数量，
#   降低长时间运行后被自动终止的概率。
#
# 构建（本地验证）：
#   docker build -f deploy/single/Dockerfile.single -t cms-single:local .
# 或由 CI（.github/workflows/build.yml）推送到 ghcr.io/735876214/cms-single:latest
# ============================================================================

# ---------- 后端：全量依赖 ----------
FROM node:20-slim AS backend-deps
WORKDIR /app/server
# 依赖锁定：仓库统一用 npm（package-lock.json + `npm ci`），不再使用 pnpm。
# 2026-10 统一的原因：此前 package.json 声明 pnpm@12.3.4 且留有 pnpm-lock.yaml，
# 但镜像与 CI 实际走 npm 且**没有 npm lockfile** → 依赖版本每次重新解析、构建不可复现；
# 且 pnpm-lock.yaml 已过期（package.json 于 09-17 改过，锁文件停在 09-14）。
COPY server/package.json server/package-lock.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund

# ---------- 后端：编译 ----------
FROM backend-deps AS backend-build
COPY server/ ./
RUN ./node_modules/.bin/prisma generate \
 && npm run build

# ---------- 后端：生产依赖（含 prisma CLI，启动时 migrate deploy 必需） ----------
FROM node:20-slim AS backend-proddeps
WORKDIR /app/server
COPY server/package.json server/package-lock.json ./
# 运行时需要 prisma CLI 执行 migrate deploy（见 start.sh）→ prisma 已**正式归入 dependencies**。
# 2026-10 修正：它原先在 devDependencies，本阶段必须先「临时把 prisma 挪进 dependencies」
#   再 --omit=dev 安装，bin 才会生成（否则报 `./node_modules/.bin/prisma: not found`，退出码 127）。
#   归入 dependencies 后该 hack 已删除：`npm ci --omit=dev` 直接可用，且锁文件对生产依赖同样生效。
# ⚠️ 不能加 --ignore-scripts：prisma 的 postinstall 负责下载 schema-engine，缺了启动 migrate deploy 会崩。
RUN npm ci --omit=dev --legacy-peer-deps --no-audit --no-fund \
 && (test -x ./node_modules/.bin/prisma || (echo "ERROR: prisma CLI 未安装（npm ci --omit=dev 后应存在）" && exit 1))
# ⚠️ generate 需要 schema：本阶段只 COPY 过 package.json，必须显式带上 prisma/（此前靠层缓存侥幸通过，
#    package.json 一变缓存失效就报 "Could not find Prisma Schema"）
COPY server/prisma ./prisma
RUN ./node_modules/.bin/prisma generate

# ---------- 前端：构建 ----------
FROM node:20-slim AS frontend-build
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund
COPY web/ ./
ENV VITE_API_BASE=/api
RUN npm run build

# ---------- 运行镜像 ----------
FROM node:20-slim AS runtime
# openssl：Prisma 查询引擎依赖；nginx：单容器内托管前端 + 反代 /api
# tzdata：让 compose 里的 TZ=Asia/Shanghai 真正生效（合同到期日等按本地时区计算）
# fonts-wqy-zenhei + fonts-wqy-microhei：汇报材料导出 PDF 要内嵌中文字体（pdf-lib 自己不带汉字字形）。
#   只装 TrueType 轮廓的字体：CFF 轮廓的（Noto CJK / 思源）pdf-lib 嵌进去会渲染成乱码，
#   `ReportService.pdfFont()` 会主动跳过它们；装上这两个后不用再配 AI_PDF_FONT。
# Acquire::Retries：镜像源偶发 502 / 连接超时（走代理时更常见）会让构建随机失败，重试几次即可通过。
RUN apt-get update -o Acquire::Retries=5 \
 && apt-get install -y --no-install-recommends -o Acquire::Retries=5 openssl ca-certificates nginx tzdata \
       fonts-wqy-zenhei fonts-wqy-microhei \
 && rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man

ENV NODE_ENV=production \
    PORT=3000 \
    TZ=Asia/Shanghai

# 后端运行文件
COPY --from=backend-proddeps /app/server/node_modules /app/server/node_modules
COPY --from=backend-build /app/server/dist /app/server/dist
COPY --from=backend-build /app/server/package.json /app/server/package.json
COPY --from=backend-build /app/server/prisma /app/server/prisma
WORKDIR /app/server

# 前端静态产物 + 单容器 nginx 配置 + 启动脚本
COPY --from=frontend-build /app/web/dist /usr/share/nginx/html
COPY deploy/single/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/single/start.sh /usr/local/bin/start.sh
RUN chmod +x /usr/local/bin/start.sh

EXPOSE 8080

# 探测对外端口（nginx 托管首页）；该探针保证容器级存活，
# 业务级自愈（后端异常）依赖 restart 策略整体重启。
# 用 node 探测（基础镜像 node:20-slim 默认不带 wget）。
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
  CMD node -e "require('net').connect(8080,'127.0.0.1').on('connect',()=>process.exit(0)).on('error',()=>process.exit(1))"

CMD ["start.sh"]
