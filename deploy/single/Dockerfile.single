# ============================================================================
# CMS 单容器镜像（前后端一体）—— 仅生成「一个」容器即可完整运行
#
# 适用场景：
#   - 部署平台对容器数量有限制（只给一个容器配额），或
#   - 多容器长时间运行后易被平台按配额逐个回收 / 终止。
#   单容器把「NestJS 后端 + SQLite」与「nginx 前端静态托管 + /api 反代」
#   合并进同一个镜像：对外只暴露一个端口，内部 nginx 把 /api 反代到
#   同容器的 127.0.0.1:3000，从而减少资源占用与容器数量，
#   降低长时间运行后被自动终止的概率。
#
# 构建（本地验证）：
#   docker build -f deploy/single/Dockerfile.single -t cms-single:local .
# 或由 CI（.github/workflows/build.yml）推送到 ghcr.io/735876214/cms-single:latest
# ============================================================================

# ---------- 后端：全量依赖 ----------
FROM node:20-slim AS backend-deps
WORKDIR /app/server
COPY server/package.json ./
RUN npm install --legacy-peer-deps --no-audit --no-fund

# ---------- 后端：编译 ----------
FROM backend-deps AS backend-build
COPY server/ ./
RUN DATABASE_URL="file:/tmp/gen.db" ./node_modules/.bin/prisma generate --schema prisma/schema.sqlite.prisma \
 && DATABASE_URL="file:/tmp/gen.db" npm run build

# ---------- 后端：生产依赖（含 prisma CLI，启动时 db push 必需） ----------
FROM node:20-slim AS backend-proddeps
WORKDIR /app/server
COPY server/package.json ./
# 运行时需要 prisma CLI 执行 db push（见 start.sh），但 prisma 在 package.json 里是 devDependency。
# ⚠️ 坑（CI 实测踩过）：直接 `npm install --no-save --omit=dev prisma@^5.10.2` 会被 npm 当成
#   dev 依赖跳过 —— 日志只打印 "up to date in 1s"，node_modules/.bin/prisma 并不生成，
#   下一步 generate 报 `./node_modules/.bin/prisma: not found`（退出码 127）。
# 正确做法：安装前把 prisma 临时挪进 dependencies，再一次性 --omit=dev 安装，bin 才会正常生成。
# 另：不能加 --ignore-scripts，否则 prisma 的 postinstall 不下载 schema-engine，启动 db push 会崩。
RUN node -e "const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));p.dependencies.prisma=p.devDependencies.prisma;delete p.devDependencies.prisma;fs.writeFileSync('package.json',JSON.stringify(p,null,2))" \
 && npm install --omit=dev --legacy-peer-deps --no-audit --no-fund \
 && (test -x ./node_modules/.bin/prisma || (echo "ERROR: prisma CLI 未安装，检查 --omit=dev 是否把它当 dev 依赖跳过了" && exit 1))
COPY server/prisma/schema.sqlite.prisma ./prisma/
RUN DATABASE_URL="file:/tmp/gen.db" ./node_modules/.bin/prisma generate --schema prisma/schema.sqlite.prisma

# ---------- 前端：构建 ----------
FROM node:20-slim AS frontend-build
WORKDIR /app/web
COPY web/package.json ./
RUN npm install --legacy-peer-deps --no-audit --no-fund
COPY web/ ./
ENV VITE_API_BASE=/api
RUN npm run build

# ---------- 运行镜像 ----------
FROM node:20-slim AS runtime
# openssl：Prisma 查询引擎依赖；nginx：单容器内托管前端 + 反代 /api
# tzdata：让 compose 里的 TZ=Asia/Shanghai 真正生效（合同到期日等按本地时区计算）
# Acquire::Retries：镜像源偶发 502 / 连接超时（走代理时更常见）会让构建随机失败，重试几次即可通过。
RUN apt-get update -o Acquire::Retries=5 \
 && apt-get install -y --no-install-recommends -o Acquire::Retries=5 openssl ca-certificates nginx tzdata \
 && rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man

ENV NODE_ENV=production \
    PORT=3000 \
    TZ=Asia/Shanghai

# 后端运行文件
COPY --from=backend-proddeps /app/server/node_modules /app/server/node_modules
COPY --from=backend-build /app/server/dist /app/server/dist
COPY --from=backend-build /app/server/package.json /app/server/package.json
COPY --from=backend-build /app/server/prisma /app/server/prisma
WORKDIR /app/server

# 前端静态产物 + 单容器 nginx 配置 + 启动脚本
COPY --from=frontend-build /app/web/dist /usr/share/nginx/html
COPY deploy/single/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/single/start.sh /usr/local/bin/start.sh
RUN chmod +x /usr/local/bin/start.sh

EXPOSE 8080

# 探测对外端口（nginx 托管首页）；该探针保证容器级存活，
# 业务级自愈（后端异常）依赖 restart 策略整体重启。
# 用 node 探测（基础镜像 node:20-slim 默认不带 wget）。
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
  CMD node -e "require('net').connect(8080,'127.0.0.1').on('connect',()=>process.exit(0)).on('error',()=>process.exit(1))"

CMD ["start.sh"]
