# 部署前复制为 .env：cp .env.example .env，然后修改下面两项。
# 注意：.env 已被 .gitignore 忽略，不会进仓库；本示例文件可安全提交。

# JWT 密钥：务必替换为强随机值，命令：openssl rand -base64 48
# 不要使用下面这个示例值，否则任何人都能伪造 token。
JWT_SECRET=change-me-to-a-strong-random-value

# 后端数据目录（SQLite 库 + 上传文件）在宿主机上的路径，按你的 NAS 修改：
#   群晖   /volume1/docker/cms/data
#   威联通 /share/CACHEDEV1_DATA/Container/cms/data
#   Unraid /mnt/user/appdata/cms/data
CMS_DATA=/volume1/docker/cms/data
