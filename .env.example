# 部署前复制：cp .env.example .env
# 本文件只放可配置项；compose 会自动读取同目录 .env 做变量插值。

# 对外访问端口（宿主机端口）
CMS_HTTP_PORT=9080

# 数据目录（SQLite 数据库 + 上传文件），NAS 建议改成绝对路径：
#   群晖   ：/volume1/docker/cms/data
#   威联通 ：/share/CACHEDEV1_DATA/Container/cms/data
#   Unraid ：/mnt/user/appdata/cms/data
CMS_DATA=./data

# JWT 签名密钥，必填且必须换成随机值：openssl rand -base64 48
# 请替换为自己的随机串，下面这串仅作占位示例（compose 里缺 JWT_SECRET 会直接拒绝启动）。
JWT_SECRET=replace-this-with-your-own-openssl-rand-base64-48-string

# 首次部署（空库）自动创建的管理员账号
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
