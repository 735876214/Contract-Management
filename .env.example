# CMS 部署变量模板 —— 复制成 .env 后填写（`.env` 已被 .gitignore 排除，不会入库）
#
#   cp .env.example .env && ${EDITOR:-vi} .env
#   docker compose up -d
#
# .env 与 compose 必须放在同一目录（compose 只会自动读取「当前工作目录/项目目录」下的 .env）。
# 没填 POSTGRES_PASSWORD 或 JWT_SECRET 时，compose 会直接报错退出——这是有意的：
# 带着空口令或占位密钥把数据库/控制台拉到公网上，等于没有口令。

# ── 端口 ────────────────────────────────────────────────
# 对外暴露的宿主机端口（容器内固定 8080，内部 nginx 托管前端并把 /api 反代到 127.0.0.1:3000）
CMS_PORT=9080

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=cms
POSTGRES_DB=cms
# 生成：openssl rand -base64 24
POSTGRES_PASSWORD=

# ── 后端 ────────────────────────────────────────────────
# 会话签名密钥，必填。生成：openssl rand -base64 48
# 换掉它 = 所有已登录用户被踢下线（正常做法：只在疑似泄漏时换）
JWT_SECRET=
JWT_EXPIRES_IN=7d
TZ=Asia/Shanghai

# 仅「空库首次启动」用于自动创建管理员；库里有数据时忽略。
# 登录后请立刻在「系统设置 → 用户」里改成自己的口令。
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# ── 数据落盘（必须是宿主机的**绝对路径**）────────────────
# 相对路径会跟着「执行 compose 时的当前目录」走：换个目录 up 就是另一套空库（2026-10-22 踩过）。
# 两者放同一父目录便于一起备份；NAS 上文件管理器直接可见，可纳入 NAS 备份计划。
#   群晖   ：/volume1/docker/cms/pgdata 与 /volume1/docker/cms/data
#   威联通 ：/share/CACHEDEV1_DATA/Container/cms/pgdata 与 .../data
#   Unraid ：/mnt/user/appdata/cms/pgdata 与 /mnt/user/appdata/cms/data
PGDATA_DIR=/volume1/docker/cms/pgdata
DATA_DIR=/volume1/docker/cms/data
