{
  "name": "cms-tooling",
  "private": true,
  "version": "1.0.0",
  "description": "仅开发期工具链（ESLint / Prettier）。业务依赖分别在各 workspace：server/ web/ mcp/",
  "scripts": {
    "lint": "eslint --quiet server/src server/test web/src mcp",
    "lint:all": "eslint server/src server/test web/src mcp",
    "lint:fix": "eslint --fix server/src web/src",
    "format": "prettier --write \"server/src/**/*.ts\" \"server/test/**/*.{ts,mts}\" \"web/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"server/src/**/*.ts\" \"web/src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0"
  }
}
