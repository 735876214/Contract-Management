# ── CMS MCP 服务端配置 ─────────────────────────────────────
# 复制为 .env（或直接写进 MCP 客户端的 env）后按需填写。
# 注意：mcp/ 是**独立的** Node 包，不读取根目录或 server/ 的 .env，
# 下面这些变量由 MCP 客户端在启动子进程时注入。

# 后端基地址（含 /api 前缀）。生产可填 https://你的域名/api
CMS_BASE_URL=http://localhost:3000/api

# 鉴权二选一：
# 1) 用户名 + 密码（MCP 会先登录换 token，token 过期自动重登）
CMS_USERNAME=admin
CMS_PASSWORD=
# 2) 或直接给一个预签发的 JWT（优先级更高，省一次登录）
# CMS_TOKEN=

# 默认项目 id（合同/物料/日报/资产/结算/付款/发票/台账等需要项目上下文）
# 工具调用时也可用 projectId 参数临时覆盖
# CMS_PROJECT_ID=

# 导出/下载落盘目录（默认 <mcp 工作目录>/exports）
# CMS_EXPORT_DIR=./exports

# 单次请求超时（毫秒，默认 30000）
# CMS_TIMEOUT_MS=30000

# HTTP 模式监听端口（仅 `--http` 模式使用，默认 8787）
# CMS_MCP_HTTP_PORT=8787
