{
  "name": "cms-mcp-server",
  "version": "1.1.0",
  "private": true,
  "description": "CMS 合同管理系统的 MCP 服务端：让外部 AI 通过 MCP 协议查询 / 导出 / 导入数据（走既有 /api，复用 RBAC 与项目隔离）",
  "type": "module",
  "bin": {
    "cms-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "pretest": "npm run build",
    "test": "node --test test/unit.test.mjs && node test/smoke.mjs && node test/http.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
