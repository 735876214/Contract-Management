import test from 'node:test';
import assert from 'node:assert/strict';
import { PDFDocument, StandardFonts } from 'pdf-lib';
import { markdownToLines, renderReportPdf, wrapText } from '../src/modules/ai/report-pdf.ts';

/**
 * 标准字体（WinAnsi，**没有汉字字形**）足够验证排版逻辑：折行、缩进、分页、页眉页脚。
 * 因此本文件的用例正文一律用 ASCII——中文由真接口实测覆盖，不在这里用标准字体硬塞。
 */
const fontOf = async () => {
  const doc = await PDFDocument.create();
  return doc.embedFont(StandardFonts.Helvetica);
};

/** 交给 renderReportPdf 的字体源：用工厂，避免依赖系统字体文件 */
const factory = (doc: PDFDocument) => doc.embedFont(StandardFonts.Helvetica);

test('markdownToLines：标题居中、层级字号递增，粗体标记被抹掉', () => {
  const lines = markdownToLines('# Monthly Report\n\n## Section One\nbody **bold** end');
  assert.equal(lines[0].text, 'Monthly Report');
  assert.equal(lines[0].center, true);
  assert.equal(lines[1].text, '');
  assert.equal(lines[2].text, 'Section One');
  assert.ok(lines[2].size > lines[3].size);
  assert.equal(lines[3].text, 'body bold end');
});

test('markdownToLines：列表变圆点行，表格分隔行被丢掉', () => {
  const lines = markdownToLines('- alpha\n- beta\n\n| item | amount |\n| --- | --- |\n| contract | 100 |');
  assert.deepEqual(
    lines.filter((l) => l.text).map((l) => l.text),
    ['alpha', 'beta', 'item  ·  amount', 'contract  ·  100'],
  );
  assert.equal(lines[0].bullet, true);
});

test('wrapText：按宽度折行且不丢字', async () => {
  const font = await fontOf();
  const text = 'The quick brown fox jumps over the lazy dog again and again';
  const parts = wrapText(text, font, 10, 120);
  assert.ok(parts.length > 1);
  // 折行后拼接（去掉换行处可能的空格丢失）应等于原文
  assert.equal(parts.join('').replace(/\s+/g, ' ').trim(), text.replace(/\s+/g, ' ').trim());
  for (const p of parts) assert.ok(font.widthOfTextAtSize(p, 10) <= 120.5);
});

test('wrapText：空串给一行空字符串，超长单词也能切', async () => {
  const font = await fontOf();
  assert.deepEqual(wrapText('', font, 10, 50), ['']);
  const long = wrapText('A'.repeat(200), font, 10, 50);
  assert.ok(long.length > 1);
  assert.equal(long.join('').length, 200);
});

test('renderReportPdf：多页材料会分页，且产出合法 PDF', async () => {
  const markdown = ['# Report Title']
    .concat(Array.from({ length: 120 }, (_, i) => `- item ${i + 1}: a fairly long line of body text to fill pages`))
    .join('\n');
  const buffer = await renderReportPdf(markdown, {
    font: factory,
    title: 'Test Report',
    footer: 'Generated by system',
    pageLabel: (i, n) => `Page ${i} / ${n}`,
  });
  assert.ok(buffer.length > 1000);
  assert.equal(buffer.subarray(0, 5).toString('latin1'), '%PDF-');
  const parsed = await PDFDocument.load(buffer);
  assert.ok(parsed.getPageCount() >= 2);
  assert.equal(parsed.getTitle(), 'Test Report');
});

test('renderReportPdf：空正文也能出单页', async () => {
  const buffer = await renderReportPdf('', {
    font: factory,
    title: 'Empty',
    footer: 'Generated by system',
    pageLabel: (i, n) => `Page ${i} / ${n}`,
  });
  const parsed = await PDFDocument.load(buffer);
  assert.equal(parsed.getPageCount(), 1);
});
