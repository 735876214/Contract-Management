DATABASE_URL="postgresql://cms:cms123456@localhost:5432/cms?schema=public"
JWT_SECRET="cms-super-secret-key"
JWT_EXPIRES_IN="7d"
PORT=3000
UPLOAD_DIR="./uploads"

# ---- Redis（可选，2026-11-24 引入）----
# 不配就自动走进程内实现（单实例口径），登录节流 / AI 问数照常可用。
# 配了才有跨实例语义：登录失败窗口共享、AI 问数 run 的事件流可被任意实例读到（断线续传前提）。
# REDIS_URL=redis://127.0.0.1:6379/0
# 与其它系统共用一个 Redis 实例时用前缀隔离键空间（默认 cms:）
# REDIS_KEY_PREFIX=cms:

# ---- 系统参数的静态加密（可选，但生产建议开）----
# 生成：openssl rand -base64 32（必须是 base64 的 32 字节）
# 不设：ai.apiKey 等密钥类参数以**明文**存库（只靠接口不回显来保护），启动时会打一条 WARN。
# 设了：写入自动加密（enc:v1: 前缀），老的明文值读得到、下次保存时自动升级。
# ⚠️ 这把钥匙必须进备份清单，且不要用会轮换的值派生——丢了就解不开已加密的密钥。
# PARAM_SECRET_KEY=

# ---- AI 助手（可选；不配置则 AI 相关能力自动降级为「手工映射」）----
# 兼容 OpenAI Chat Completions 协议的任一服务（云端 API 即可，无需出网白名单之外的特殊条件）
# 更推荐部署后在「系统管理 → AI 信息登记」页面填下面三项：存数据库、保存即生效、不用重启，
# 且优先级高于这里（逐项回落：页面 > env > 默认）。下面的留空即可。
# 也读但一般不用设：AI_ENABLED=false 可全局关掉 AI（页面开关优先级更高）
# AI_ENABLED=true
# 剩下的调优项只认这里，页面不暴露：
# AI_MAX_TOKENS=4000  单次返回上限（推理型上游会先吃掉思维链，见 llm-client 翻倍重试）
# AI_MAX_TEXT_CHARS=40000  送给模型的原文字数上限
# AI_PDF_FONT=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc  导出 PDF 的中文字体
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
# 用途级模型（2026-10-23）：不填就用上面的 AI_MODEL；也可以在页面「按用途指定模型」里填（页面优先）
# AI_MODEL_FORM_INSPECT=""   表单核验（短文本 + 结构化 JSON，便宜模型够用）
# AI_MODEL_REGISTER=""       文件登记（长正文，建议上下文大的模型）
# AI_MODEL_REPORT=""         汇报材料（长输出、重措辞）
# AI_MODEL_ANOMALY=""        异常预警：结算/报价/履约三类（重推理）
AI_TIMEOUT_MS=30000
# 单文件业务上限（字节）。multer 硬上限 50MB，nginx client_max_body_size 也是 50m
AI_MAX_FILE_BYTES=5242880
AI_MAX_CANDIDATES=300
# 一次送进 prompt 的最大字段数（字段目录共 43 项，超过就截断）
AI_MAX_FIELDS=120
AI_HOURLY_LIMIT=60
