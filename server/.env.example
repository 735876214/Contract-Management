DATABASE_URL="postgresql://cms:cms123456@localhost:5432/cms?schema=public"
JWT_SECRET="cms-super-secret-key"
JWT_EXPIRES_IN="7d"
PORT=3000
UPLOAD_DIR="./uploads"

# ---- AI 助手（可选；不配置则 AI 相关能力自动降级为「手工映射」）----
# 兼容 OpenAI Chat Completions 协议的任一服务（云端 API 即可，无需出网白名单之外的特殊条件）
# 更推荐部署后在「系统管理 → AI 信息登记」页面填下面三项：存数据库、保存即生效、不用重启，
# 且优先级高于这里（逐项回落：页面 > env > 默认）。下面的留空即可。
# 也读但一般不用设：AI_ENABLED=false 可全局关掉 AI（页面开关优先级更高）
# AI_ENABLED=true
# 剩下的调优项只认这里，页面不暴露：
# AI_MAX_TOKENS=4000  单次返回上限（推理型上游会先吃掉思维链，见 llm-client 翻倍重试）
# AI_MAX_TEXT_CHARS=40000  送给模型的原文字数上限
# AI_PDF_FONT=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc  导出 PDF 的中文字体
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
AI_TIMEOUT_MS=30000
# 单文件业务上限（字节）。multer 硬上限 50MB，nginx client_max_body_size 也是 50m
AI_MAX_FILE_BYTES=5242880
AI_MAX_CANDIDATES=300
# 一次送进 prompt 的最大字段数（字段目录共 43 项，超过就截断）
AI_MAX_FIELDS=120
AI_HOURLY_LIMIT=60
