// 企业合同管理系统 · 数据模型
// 约定：
// 1) 字典关联字段一律存储「字典项编码」字符串，由字典服务校验，不使用数据库枚举；
// 2) 所有业务表均带 projectId，实现项目级数据隔离；
// 3) 供应商信息不冗余进合同，合同仅存 supplierId，台账实时关联。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- 组织与权限 ----------------

model Dept {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  leader    String?
  sort      Int      @default(0)
  status    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  password     String
  realName     String
  phone        String?
  email        String?
  deptId       String?
  status       Int      @default(1)
  isSuperAdmin Boolean  @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dept          Dept?            @relation(fields: [deptId], references: [id])
  roles         UserRole[]
  members       ProjectMember[]
  notifications Notification[]
  operationLogs OperationLog[]
  loginLogs     LoginLog[]
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  remark      String?
  status      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  module    String
  createdAt DateTime @default(now())
  roles     RolePermission[]
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ---------------- 项目 ----------------

model Project {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  nameAbbr    String? // 项目简称（文字版）
  codeAbbr    String? @unique // 项目简称（字母版，用于合同编号第3段，仅大写字母和数字）
  undertaker  String? // 承接单位
  selfContractAmount Decimal? @db.Decimal(18, 2) // 项目自施合同额（万元）
  industryType String? // dict: industry_type 项目业态
  status      String?  // dict: project_status
  description String?
  startDate   DateTime?
  endDate     DateTime?
  managerId   String?
  createdAt   DateTime @default(now())
  version    Int      @default(0) // 乐观锁版本号，更新时校验
  updatedAt   DateTime @updatedAt

  members      ProjectMember[]
  contracts    Contract[]
  dailyReports DailyReport[]
  settlements  Settlement[]
  ledgers      SettlementLedger[]
  payments     PaymentRecord[]
  invoices     Invoice[]
  repayments   RepaymentAgreement[]
  assets       AssetLedger[]
  receiptOrders ReceiptOrder[]
  procurementTemplates ProcurementTemplate[]
  procurementTasks     ProcurementTask[]
  procurementTotalItems ProcurementTotalItem[]
  @@index([createdAt])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  roleCode  String   @default("MEMBER") // dict: project_member_role
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

// ---------------- 供应商 ----------------

model Supplier {
  id                 String   @id @default(cuid())
  name               String   @unique
  legalPerson        String? // 法人姓名
  legalPhone         String? // 法人电话
  contractAuthPerson String? // 合同授权人姓名
  contractAuthPhone  String? // 合同授权人电话
  contractAuthIdNo   String? // 合同授权人身份证号
  contactName        String? // 联系人姓名
  contactPhone       String? // 联系人电话
  contactEmail       String? // 联系人邮箱
  bankName           String? // 银行名称
  bankAccount        String? // 银行账号
  address            String? // 公司地址
  remark             String?
  status             Int      @default(1) // 1 启用 0 停用
  projectId          String? // 全局共享时为空
  createdAt          DateTime @default(now())
  version    Int      @default(0) // 乐观锁版本号，更新时校验
  updatedAt          DateTime @updatedAt

  contracts   Contract[]
  reports     DailyReport[]
  repayments  RepaymentAgreement[]
  assets      AssetLedger[]
  receiptOrders ReceiptOrder[]
}

// ---------------- 分包商库（分包材料员授权委托书） ----------------

model Subcontractor {
  id                    String   @id @default(cuid())
  projectId             String? // 所属项目，全局共享时为空
  subcontractorName     String // 分包商名称
  subcontractContent    String? // 分包合同内容（关联的分包合同说明）
  subcontractId         String? // 关联的分包合同 ID（用于与分包合同互锁）
  legalPerson           String? // 法人姓名
  authorizedPerson      String? // 材料授权人姓名
  authorizedPersonIdNo  String? // 材料授权人身份证号
  projectName           String? // 项目名称（授权委托书内填写）
  idCardFront           String? // 材料授权人身份证照片正面
  idCardBack            String? // 材料授权人身份证照片反面
  signatureScreenshot   String? // 材料授权人签字部分截图
  signedAuthFile        String? // 签字盖章版委托书（扫描件/PDF）
  status                String   @default("EDITING") // EDITING 编辑中 / COMPLETED 已完成
  remark                String?
  createdBy             String?
  createdAt             DateTime @default(now())
  version               Int      @default(0)
  updatedAt             DateTime @updatedAt

  @@index([projectId])
  @@index([subcontractorName])
}

// ---------------- 合同 ----------------

model Contract {
  id                 String    @id @default(cuid())
  projectId          String
  code               String // 合同编号
  name               String
  typeCode           String? // dict: contract_type
  subTypeCode        String? // dict: contract_sub_type 合同子类型（编号第4段）
  supplierId         String?
  signDate           DateTime?
  amount             Decimal?  @db.Decimal(18, 2)
  taxRate            Decimal?  @db.Decimal(9, 4)
  paymentMethodCode  String? // dict: payment_method
  isFramework        String? // dict: yes_no
  isSupplement       String? // dict: yes_no
  parentContractId   String? // 主合同ID（补充协议链）
  yearSeq            String? // 年度顺序码（合同编号生成规则，如 2026001）
  codeAbbrUsed       String? // 编号第3段项目字母简称（生成时固化）
  supplementSeq      Int?    // 补充协议序号
  supplementTypeCode String? // dict: supplement_agreement_type
  execStatus         String? // dict: contract_execution_status
  status             String? // dict: contract_status 起草流转状态：DRAFT 草稿中 / COMPLETED 已完成
  templateId         String? // 关联合同模板 ID（起草时选择，用于回填与预览）
  formData           String? // 模板变量填写值（JSON 文本，key=变量键）
  materialDescription String? // 物资名称（合同名称第4段，用户手填，如：PE管）
  technicalClauseId  String? // 技术条款 ID（需求 2.3：创建合同时选择）
  qualityClauseId    String? // 质量条款 ID
  paymentClauseId    String? // 付款条件 ID
  acceptanceClauseId String? // 验收方式 ID
  signedFilePath     String? // 签章合同文件相对路径（相对上传目录，需求：合同签章）
  signedFileName     String? // 签章合同原始文件名
  signedDate         DateTime? // 签章时记录的签订日期
  signedRemark       String? // 签章备注
  signedAt           DateTime? // 签章操作时间（每次签章/重新签章刷新）
  remark             String?
  paymentMode        String? // 资金费用-付款模式：100 / 3382 / CUSTOM（可覆盖系统默认）
  monthlyRate        Decimal? @db.Decimal(18, 6) // 延期月利率（如 0.006 表示 0.6%）
  graceDays          Int?     // 逾期宽限天数
  interestCapRatio   Decimal? @db.Decimal(9, 4) // 逾期利息上限比例（如 0.05 表示 5%）
  createdBy          String?
  createdAt          DateTime  @default(now())
  version    Int      @default(0) // 乐观锁版本号，更新时校验
  updatedAt          DateTime  @updatedAt

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier     Supplier?            @relation(fields: [supplierId], references: [id])
  parentContract Contract?          @relation("SupplementChain", fields: [parentContractId], references: [id])
  supplements  Contract[]           @relation("SupplementChain")
  ext          ContractExt?
  attachments  ContractAttachment[]
  changeLogs   ContractChangeLog[]
  reports      DailyReport[]
  settlements  Settlement[]
  ledgers      SettlementLedger[]
  payments     PaymentRecord[]
  invoices     Invoice[]
  repayments   RepaymentAgreement[]
  materials    ContractMaterial[]
  materialPools    ContractMaterialPool[]
  draftMaterials   ContractDraftMaterial[]
  factoringCosts   FactoringCost[]
  overdueInterests OverdueInterest[]
  receiptAsMaterialContract ReceiptOrder[] @relation("ReceiptMaterialContract")
  receiptAsSubcontract       ReceiptOrder[] @relation("ReceiptSubcontract")
  receiptAsSupplySubcontract ReceiptOrder[] @relation("ReceiptSupplySubcontract")

  @@unique([projectId, code])
  @@index([projectId, supplierId])
}

model ContractExt {
  id              String    @id @default(cuid())
  contractId      String    @unique
  financeCode     String? // 财务一体化合同编号
  procurementSrc  String? // dict: procurement_source
  isDirectPurchase String? // dict: is_direct_purchase
  bidName         String? // 招标名称
  currentPayRatio Decimal?  @db.Decimal(9, 4) // 当前合同付款比例
  supplierCategory String? // dict: supplier_category
  bidStartDate    DateTime? // 开始招标时间
  bidWinDate      DateTime? // 定标时间
  disclosureDate  DateTime? // 合同交底时间
  complaint       String? // 投诉情况
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model ContractAttachment {
  id         String   @id @default(cuid())
  contractId String
  fileName   String
  url        String
  size       Int?
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model ContractChangeLog {
  id          String   @id @default(cuid())
  contractId  String
  field       String
  fieldLabel  String?
  beforeValue String?
  afterValue  String?
  operatorId  String?
  operator    String?
  createdAt   DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

// ---------------- 模板 ----------------

model ContractTemplate {
  id          String   @id @default(cuid())
  name        String
  categoryCode String? // dict: contract_template_category
  tags        String?
  status      Int      @default(1)
  version     Int      @default(1)
  content     String?  @db.Text
  pageSetup   String?  // 页面设置（JSON：页边距/页眉/页脚页码等），生成 Word 时生效
  projectId   String? // 空表示全局共享
  parentId    String? // 上一版本
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variables TemplateVariable[]
}

model TemplateVariable {
  id           String   @id @default(cuid())
  templateId   String
  varKey       String
  varLabel     String?
  sourceType   String   @default("MANUAL") // SUPPLIER / CONTRACT / MANUAL
  defaultValue String?
  createdAt    DateTime @default(now())

  template ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Clause {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  categoryCode String?
  type        String? // 条款类型（需求 2.3 固定四种）：technical 技术条款 / quality 质量条款 / payment 付款条件 / acceptance 验收方式
  sortOrder   Int      @default(0)
  status      Int      @default(1)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------- 日报 ----------------

model DailyReport {
  id               String    @id @default(cuid())
  projectId        String
  materialBaseId   String? // 物资主数据（物资名称/规格型号来源，禁止手输，应用层同步快照）
  periodYear       Int?
  periodMonth      Int?
  entryDate        DateTime? // 进场日期
  contractId       String?
  isAsset          String?   // dict: yes_no（来自物资基础库，禁止手工维护）
  isSafetyMaterial String?   // dict: yes_no（来自物资基础库，禁止手工维护）
  assetSupervision String?   // 资产监管
  department       String?
  personnel        String?
  assetStatus      String?   // dict: asset_status
  sourceCode       String?   // dict: material_source
  materialCategory String?   // dict: material_category
  materialType     String?   // dict: material_type（按类别联动）
  materialName     String?
  steelBrand       String?
  steelCount       Int?
  spec             String?
  unit             String?   // dict: measurement_unit
  weighQty         Decimal?  @db.Decimal(18, 3)
  deductQty        Decimal?  @db.Decimal(18, 3)
  settleQty        Decimal?  @db.Decimal(18, 3)
  isWeighed        String?   // dict: yes_no
  noAcceptReason   String?   // 未云筑验收原因
  priceBeforeTax   Decimal?  @db.Decimal(18, 4)
  taxRate          Decimal?  @db.Decimal(9, 4)
  priceAfterTax    Decimal?  @db.Decimal(18, 4)
  amountBeforeTax  Decimal?  @db.Decimal(18, 2)
  amountAfterTax   Decimal?  @db.Decimal(18, 2)
  supplierId       String?   // 供应单位
  receiveUnit      String?
  receiver         String?
  laborContract    String?
  usePosition      String?
  isProxy          String?   // 是否代购
  plateNo          String?
  receiptNo        String?
  remark           String?
  subcontractPeriod String?
  incomePrice      Decimal?  @db.Decimal(18, 4)
  incomeAmount     Decimal?  @db.Decimal(18, 2)
  stdPrice         Decimal?  @db.Decimal(18, 4)
  stdAmount        Decimal?  @db.Decimal(18, 2)
  createdAt        DateTime  @default(now())
  version    Int      @default(0) // 乐观锁版本号，更新时校验
  updatedAt        DateTime  @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contract Contract? @relation(fields: [contractId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  materialBase MaterialBase? @relation(fields: [materialBaseId], references: [id])

  @@index([projectId, contractId])
  @@index([contractId])
  @@index([supplierId])
  @@index([materialBaseId])
  @@index([entryDate])
  @@index([projectId, createdAt])
}

// ---------------- 物资基础库 ----------------

model MaterialBase {
  id        String   @id @default(cuid())
  name      String // 物资名称
  spec      String // 规格型号
  categoryLevel1 String? // 一级分类（dict: material_category_l1）
  categoryLevel2 String? // 二级分类（dict: material_category_l2）
  mdmCode   String? // MDM编码
  dscCode   String? // DSC编码
  unit      String? // 计量单位（dict: measurement_unit，创建后不可修改）
  isAsset          Boolean @default(false) // 是否资产（需求 2.1.1）
  isSafetyMaterial Boolean @default(false) // 是否安全物资（需求 2.1.1）
  status    Int      @default(1) // 1 启用 0 停用（软删除）
  remark    String?
  createdAt DateTime @default(now())
  version    Int      @default(0) // 乐观锁版本号，更新时校验
  updatedAt DateTime @updatedAt

  contractMaterials ContractMaterial[]
  contractPools     ContractMaterialPool[]
  draftMaterials    ContractDraftMaterial[]
  reports           DailyReport[]

  @@unique([name, spec]) // 物资名称 + 规格型号 组合唯一（主数据唯一约束）
  @@index([name])
}

// ---------------- 合同物资清单（合同 × 物资 实例行） ----------------

model ContractMaterial {
  id             String    @id @default(cuid())
  contractId     String
  materialBaseId String // 引用物资基础库，不重复录入名称/规格/编码
  unit           String // 计量单位（针对本合同的计量方式）
  qty            Decimal?  @db.Decimal(18, 4) // 暂定数量
  priceBeforeTax Decimal?  @db.Decimal(18, 4) // 税前单价
  taxRatePct     Decimal?  @db.Decimal(5, 2) // 增值税（百分比，如 13.00）
  priceWithTax   Decimal?  @db.Decimal(18, 4) // 含税单价 = 税前单价 × (1 + 增值税/100)
  totalWithTax   Decimal?  @db.Decimal(18, 4) // 暂定含税合价 = 暂定数量 × 含税单价
  remark         String?
  incomePrice    Decimal?  @db.Decimal(18, 4) // 收入单价
  incomeTotal    Decimal?  @db.Decimal(18, 4) // 收入合价 = 暂定数量 × 收入单价
  stdPrice       Decimal?  @db.Decimal(18, 4) // 标准成本单价
  stdTotal       Decimal?  @db.Decimal(18, 4) // 标准成本合价 = 暂定数量 × 标准成本单价
  sortOrder      Int       @default(0) // 行号，可手动调整
  createdAt      DateTime  @default(now())
  version    Int      @default(0) // 乐观锁版本号，更新时校验
  updatedAt      DateTime  @updatedAt

  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  materialBase MaterialBase @relation(fields: [materialBaseId], references: [id], onDelete: Restrict)

  @@unique([contractId, materialBaseId]) // 同一物资在一个合同内只能出现一次
  @@index([contractId])
}

// ---------------- 合同起草：物料编码清单（合同专属物资池） ----------------
model ContractMaterialPool {
  id             String   @id @default(cuid())
  contractId     String
  materialBaseId String // 引用物资基础库
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  materialBase MaterialBase @relation(fields: [materialBaseId], references: [id], onDelete: Restrict)

  @@unique([contractId, materialBaseId])
  @@index([contractId])
}

// ---------------- 合同起草：草稿合同清单（发布后推送至 ContractMaterial） ----------------
model ContractDraftMaterial {
  id             String   @id @default(cuid())
  contractId     String
  materialBaseId String
  seqNo          Int? // 序号
  unit           String? // 计量单位
  qty            Decimal?  @db.Decimal(18, 4) // 暂定数量
  priceBeforeTax Decimal?  @db.Decimal(18, 4) // 税前单价
  taxRatePct     Decimal?  @db.Decimal(5, 2) // 税率（百分比，如 13.00）
  priceWithTax   Decimal?  @db.Decimal(18, 4) // 含税单价 = 税前单价 × (1 + 税率/100)
  totalWithTax   Decimal?  @db.Decimal(18, 4) // 暂定含税合价 = 含税单价 × 暂定数量
  remark         String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  materialBase MaterialBase @relation(fields: [materialBaseId], references: [id], onDelete: Restrict)

  @@unique([contractId, materialBaseId])
  @@index([contractId])
}

// ---------------- 结算 ----------------

model Settlement {
  id           String    @id @default(cuid())
  projectId    String
  contractId   String?
  code         String?
  typeCode     String?   // dict: settlement_type
  amount       Decimal?  @db.Decimal(18, 2)
  deductAmount Decimal?  @db.Decimal(18, 2)
  actualAmount Decimal?  @db.Decimal(18, 2)
  settleDate   DateTime?
  statusCode   String?   // dict: settlement_status
  remark       String?
  createdAt    DateTime  @default(now())
  version    Int      @default(0) // 乐观锁版本号，更新时校验
  updatedAt    DateTime  @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  @@index([projectId, contractId])
  @@index([settleDate])
  @@index([projectId, createdAt])
}

model SettlementLedger {
  id                 String   @id @default(cuid())
  projectId          String
  contractId         String?
  settleMonth        String?  // YYYY-MM
  monthSettleAmount  Decimal? @db.Decimal(18, 2) // 本月结算额
  monthInvoiceAmount Decimal? @db.Decimal(18, 2) // 本月开票额
  settleCount        Int?     // 结算次数
  yearSettleAmount   Decimal? @db.Decimal(18, 2)
  cumPurchaseAmount  Decimal? @db.Decimal(18, 2) // 截止当月开累采购额
  startSettleAmount  Decimal? @db.Decimal(18, 2) // 开工结算额
  monthActualPurchase Decimal? @db.Decimal(18, 2)
  factoringDiscount  Decimal? @db.Decimal(18, 2) // 保理贴息
  overdueInterest    Decimal? @db.Decimal(18, 2) // 逾期利息
  yearSettleIncome   Decimal? @db.Decimal(18, 2)
  cumSettleIncome    Decimal? @db.Decimal(18, 2)
  isOnAccount        String?  // dict: yes_no 是否挂账
  remark             String?
  createdAt          DateTime @default(now())
  version    Int      @default(0) // 乐观锁版本号，更新时校验
  updatedAt          DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([projectId, contractId, settleMonth]) // 同一合同同一结算月份仅一条台账
  @@index([contractId, settleMonth])
  @@index([settleMonth])
  @@index([projectId, createdAt])
}

// ---------------- 付款 ----------------

model PaymentRecord {
  id         String    @id @default(cuid())
  projectId  String
  contractId String?
  applyId    String?
  payMonth   String?   // YYYY-MM 付款月份
  amount     Decimal?  @db.Decimal(18, 2) // 本月付款额
  methodCode String?   // dict: payment_method
  payDate    DateTime?
  receiptUrl String?   // 银行回单
  statusCode String?   // dict: payment_status
  remark     String?
  createdAt  DateTime  @default(now())
  version    Int      @default(0) // 乐观锁版本号，更新时校验
  updatedAt  DateTime  @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  @@index([contractId])
  @@index([payMonth])
  @@index([projectId, createdAt])
}

// ---------------- 发票 ----------------

model Invoice {
  id                   String    @id @default(cuid())
  projectId            String
  contractId           String?
  goodsCategory        String?   // dict: goods_category
  settlePeriod         String?   // 结算账期
  invoiceCode          String?
  invoiceNo            String?
  typeCode             String?   // dict: invoice_type
  invoiceDate          DateTime?
  issuer               String?   // 开票单位
  receiver             String?
  amountBeforeTax      Decimal?  @db.Decimal(18, 2)
  taxRate              Decimal?  @db.Decimal(9, 4)
  amountWithTax        Decimal?  @db.Decimal(18, 2)
  receiveDate          DateTime? // 发票收取时间
  reviewStatus         String?   // dict: invoice_review_status
  responsiblePerson    String?
  financeTransferStatus String?  // dict: finance_transfer_status
  imageUrl             String?
  statusCode           String?   // dict: invoice_status
  remark               String?
  createdAt            DateTime  @default(now())
  version    Int      @default(0) // 乐观锁版本号，更新时校验
  updatedAt            DateTime  @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([projectId, invoiceNo])
  @@index([contractId])
  @@index([settlePeriod])
  @@index([projectId, createdAt])
}

// ---------------- 还款协议 ----------------

model RepaymentAgreement {
  id               String    @id @default(cuid())
  projectId        String
  code             String // 签订协议编号（项目内唯一）
  supplierId       String?
  contractId       String?
  material         String? // 供应材料
  signDate         DateTime?
  settleAmount     Decimal?  @db.Decimal(18, 2)
  agreedDebtAmount Decimal?  @db.Decimal(18, 2) // 协议约定欠款金额
  paidBeforeSign   Decimal?  @db.Decimal(18, 2)
  paidAfterSign    Decimal?  @db.Decimal(18, 2)
  overdueUnpaid    Decimal?  @db.Decimal(18, 2)
  remark           String?
  createdAt        DateTime  @default(now())
  version    Int      @default(0) // 乐观锁版本号，更新时校验
  updatedAt        DateTime  @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier  Supplier?         @relation(fields: [supplierId], references: [id])
  contract  Contract?         @relation(fields: [contractId], references: [id])
  details   RepaymentDetail[]

  @@unique([projectId, code])
  @@index([contractId])
  @@index([supplierId])
}

model RepaymentDetail {
  id          String    @id @default(cuid())
  agreementId String
  period      Int?      // 期数
  amount      Decimal?  @db.Decimal(18, 2)
  dueDate     DateTime?
  remark      String?
  createdAt   DateTime  @default(now())

  agreement RepaymentAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
}

// ---------------- 资金费用台账 ----------------

// 保理费用台账：供应商保理融资产生的利息、手续费（费用合计 = 融资利息 + 手续费，含税）
model FactoringCost {
  id                String    @id @default(cuid())
  contractId        String
  seqNo             Int       @default(0) // 序号
  financingDate     DateTime? // 融资到账时间
  financingAmount   Decimal?  @db.Decimal(18, 2) // 融资金额
  actualReceipt     Decimal?  @db.Decimal(18, 2) // 实际到账金额
  financingInterest Decimal?  @db.Decimal(18, 2) // 融资利息
  handlingFee       Decimal?  @db.Decimal(18, 2) // 手续费
  totalCost         Decimal?  @db.Decimal(18, 2) // 费用合计（含税）= 融资利息 + 手续费，服务端自动计算
  settlementMonth   String?   // 结算月份（YYYY-MM，"某年某月已办结算"）
  remark            String?   // 备注
  createdAt         DateTime  @default(now())
  version    Int      @default(0) // 乐观锁版本号，更新时校验
  updatedAt         DateTime  @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

// 逾期利息台账：仅材料款计息，DAYS360，公式 = ROUND(计息金额 × 逾期天数 × 月利率 ÷ 30, 2)
model OverdueInterest {
  id                 String    @id @default(cuid())
  contractId         String
  settlementMonth    String    // 结算月份（YYYY-MM）
  materialAmount     Decimal?  @db.Decimal(18, 2) // 材料款金额（不含资金费用）
  paymentRatio       Decimal?  @db.Decimal(9, 4)  // 付款比例（0.8 = 80%）
  payableAmount      Decimal?  @db.Decimal(18, 2) // 应付款金额 = 材料款 × 付款比例，服务端自动计算
  payableDate        DateTime? // 应付款日期（按付款模式推导，可手动覆盖）
  overdueStartDate   DateTime? // 逾期起始日期 = 应付款日期 + 宽限期 + 1 天，服务端自动计算
  paymentDate        DateTime? // 实际付款日期
  paymentAmount      Decimal?  @db.Decimal(18, 2) // 本次付款金额（0 表示对剩余金额计息一次）
  interestAmount     Decimal?  @db.Decimal(18, 2) // 计息金额：有付款 = 付款金额；无付款 = 剩余未付金额，服务端自动计算
  overdueDays        Int?      // 逾期天数 = DAYS360(逾期起始日期, 付款日期)，服务端自动计算
  monthlyRate        Decimal?  @db.Decimal(18, 6) // 延期月利率（行级快照，取合同覆盖值或系统默认）
  overdueInterest    Decimal?  @db.Decimal(18, 2) // 逾期利息（含税），服务端自动计算
  waived             Boolean   @default(false)    // 谈判减免：为 true 时利息记 0
  prevCumulative     Decimal?  @db.Decimal(18, 2) // 上期开累逾期利息（期初，手动录入或自动取上一结算月份）
  remark             String?
  isSettlementPeriod Boolean   @default(true) // 是否为本期结算行（区分开累/本期）
  periodSeq          Int       @default(0)    // 同一结算月份内的行序号（多笔付款）
  createdAt          DateTime  @default(now())
  version    Int      @default(0) // 乐观锁版本号，更新时校验
  updatedAt          DateTime  @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, settlementMonth])
}

// ---------------- 资产管理台账 ----------------

// 资产进出与状态变动：在用/闲置/报废/丢失互斥统计；原值固定不随周转变动
model AssetLedger {
  id                String    @id @default(cuid())
  projectId         String
  date              DateTime? // 日期
  sourceCode        String? // dict: asset_ledger_source（采购/调入/调出/调入费/维保费/处置出售/处置出租）
  categoryL1Code    String? // dict: asset_category_l1（资产类别一级）
  categoryFocusCode String? // dict: asset_category_focus（重点关注类别）
  name              String? // 资产名称
  spec              String? // 规格型号
  unit              String? // dict: measurement_unit
  qty               Decimal?  @db.Decimal(18, 4) // 进/出场数量（调入费行为空）
  price             Decimal?  @db.Decimal(18, 2) // 进/出场单价
  totalAmount       Decimal?  @db.Decimal(18, 2) // 进/出场总额（资产现值）= 数量 × 单价，服务端自动计算
  supplierId        String?
  receiveUnit       String? // 领用单位/部门
  responsible       String? // 责任人
  inUseQty          Decimal?  @db.Decimal(18, 4) // 在用数量
  idleQty           Decimal?  @db.Decimal(18, 4) // 闲置数量
  scrapQty          Decimal?  @db.Decimal(18, 4) // 报废数量
  lostQty           Decimal?  @db.Decimal(18, 4) // 丢失数量
  inUseAmount       Decimal?  @db.Decimal(18, 2) // 在用金额 = 在用数量 × 单价，自动
  idleAmount        Decimal?  @db.Decimal(18, 2) // 闲置金额，自动
  scrapAmount       Decimal?  @db.Decimal(18, 2) // 报废金额，自动
  lostAmount        Decimal?  @db.Decimal(18, 2) // 丢失金额，自动
  remark            String?
  turnoverCount     Int? // 周转次数（含本次）
  originalPrice     Decimal?  @db.Decimal(18, 2) // 原值单价（固定不变）
  originalTotal     Decimal?  @db.Decimal(18, 2) // 原值总额 = 原值单价 × 数量，自动
  transferOutPrice  Decimal?  @db.Decimal(18, 2) // 调出物资本项目进场时单价
  transferOutAmount Decimal?  @db.Decimal(18, 2) // 调出金额 = 调出单价 × 数量，自动
  receiptOrderId    String? // 来源收领单 ID（收领单自动入账时写入）
  receiptDetailId   String? // 来源收领单明细 ID（防重唯一键，需求 2.2.2）
  createdAt         DateTime  @default(now())
  version    Int      @default(0) // 乐观锁版本号，更新时校验
  updatedAt         DateTime  @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@unique([receiptDetailId])
  @@index([projectId])
  @@index([receiptOrderId])
}

// ---------------- 通知与日志 ----------------

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  content   String?
  type      String   @default("SYSTEM")
  bizType   String?
  bizId     String?
  projectId String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OperationLog {
  id        String   @id @default(cuid())
  userId    String?
  username  String?
  module    String?
  action    String?
  method    String?
  url       String?
  params    String?  @db.Text
  ip        String?
  // —— 审计增强：变更前/后数据、结果、耗时、业务标识 ——
  beforeData String? @db.Text
  afterData  String? @db.Text
  result     String? // SUCCESS / FAIL
  message    String?
  duration   Int?
  bizType    String?
  bizId      String?
  projectId  String?
  // —— 导入专项统计 ——
  importFile   String?
  importRows   Int?
  successCount Int?
  failCount    Int?
  errorFileUrl String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@index([module, action])
}

// ---------------- 异步导入任务 ----------------

model ImportTask {
  id            String   @id @default(cuid())
  module        String // 业务模块标识，如 contract / supplier / material
  moduleName    String? // 模块中文名
  fileName      String?
  totalRows     Int      @default(0)
  processedRows Int      @default(0)
  successCount  Int      @default(0)
  failCount     Int      @default(0)
  status        String   @default("PENDING") // PENDING / RUNNING / SUCCESS / FAILED
  errorFileUrl  String?
  message       String?
  projectId     String?
  userId        String?
  username      String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

// ---------------- 数据归档记录 ----------------

model ArchiveLog {
  id        String   @id @default(cuid())
  table     String // 归档来源表
  fromDate  DateTime?
  toDate    DateTime?
  rows      Int      @default(0)
  filePath  String?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  username  String?
  ip        String?
  userAgent String?
  result    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

// ---------------- 字典与参数 ----------------

model DictType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  remark    String?
  sort      Int      @default(0)
  status    Int      @default(1)
  isSystem  Boolean  @default(false)
  scope     String   @default("GLOBAL") // GLOBAL / PROJECT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DictItem {
  id        String   @id @default(cuid())
  typeCode  String
  itemCode  String
  itemName  String
  sortOrder Int      @default(0)
  status    Int      @default(1)
  color     String?
  remark    String?
  extField1 String? // 扩展字段1（如 material_type 关联 material_category）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([typeCode, itemCode])
  @@index([typeCode])
}

model SysParam {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------- 收领单（日报管理 → 收领单，与总日报平级） ----------------

model ReceiptOrder {
  id                 String    @id @default(cuid())
  projectId          String
  orderNo            String // 收领单编号，自动生成（如 SO00009cy000217）
  supplierId         String? // 供应单位
  supplierName       String? // 供应单位名称（快照）
  supplierType       String? // 供应单位类型：SUPPLIER 供应商 / OTHER_PROJECT 其他项目 / SUBCONTRACTOR 分包商 / SELF_PROJECT 本项目
  receivingUnitId    String? // 领用单位 ID
  receivingUnitName  String? // 领用单位名称（快照）
  receivingUnitType  String? // 领用单位类型：SUBCONTRACTOR 分包商 / SELF_PROJECT 本项目 / OTHER_PROJECT 其他项目
  subcontractId      String? // 分包合同 ID（领用单位选分包商时）
  subcontractName    String? // 分包合同名称（快照）
  supplySubcontractId   String? // 供应分包合同 ID（供应单位选分包商时）
  supplySubcontractName String? // 供应分包合同名称（快照）
  subcontractorId    String? // 关联分包商 ID（供应单位/领用单位选分包商时，用于领料人下拉与合同互锁）
  orderDate          DateTime? // 日期
  receiver           String? // 领料人（最长 50 字符）
  materialContractId String? // 物资合同 ID
  materialContractNo String? // 物资合同编号（快照）
  status             String    @default("DRAFT") // DRAFT 草稿 / SAVED 已保存
  pushedAt           DateTime? // 推送总日报时间
  remark             String?
  createdBy          String?
  createdAt          DateTime  @default(now())
  version            Int       @default(0) // 乐观锁版本号
  updatedAt          DateTime  @updatedAt

  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier         Supplier?           @relation(fields: [supplierId], references: [id])
  materialContract Contract?           @relation("ReceiptMaterialContract", fields: [materialContractId], references: [id])
  subcontract      Contract?           @relation("ReceiptSubcontract", fields: [subcontractId], references: [id])
  supplySubcontract Contract?          @relation("ReceiptSupplySubcontract", fields: [supplySubcontractId], references: [id])
  details          ReceiptOrderDetail[]

  @@unique([projectId, orderNo])
  @@index([projectId, orderDate])
  @@index([materialContractId])
  @@index([supplierId])
}

model ReceiptOrderDetail {
  id                String   @id @default(cuid())
  orderId           String
  materialId        String? // 物资 ID（引用物资基础库）
  categoryLevel1    String? // 一级分类
  categoryLevel2    String? // 二级分类
  materialName      String? // 物资名称
  specModel         String? // 规格型号
  unit              String? // 计量单位
  contractQty       Decimal? @db.Decimal(18, 4) // 合同数量
  deliveryQty       Decimal? @db.Decimal(18, 4) // 送货数量（手动填写）
  receivedQty       Decimal? @db.Decimal(18, 4) // 实收数量（手动填写）
  priceBeforeTax    Decimal? @db.Decimal(18, 4) // 税前单价
  taxRate           Decimal? @db.Decimal(9, 4) // 税率（百分比，如 13.00）
  priceWithTax      Decimal? @db.Decimal(18, 4) // 综合单价 = 税前单价 × (1 + 税率/100)
  totalPrice        Decimal? @db.Decimal(18, 2) // 综合总价 = 实收数量 × 综合单价
  usagePart         String? // 使用部位
  brand             String? // 厂家/品牌
  remark            String? // 备注
  isAgentPurchase   String? // 是否代购（dict: yes_no）
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order ReceiptOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ---------------- 采购模板（批次一 · 任务 1.2） ----------------

model ProcurementTemplate {
  id           String   @id @default(cuid())
  projectId    String
  moduleType   String // 采购模块类型：INITIATE/PRE_MEETING/NOTICE/DOCUMENT/RESULT_REPORT/PRICE_COMPARE/FRAMEWORK/INSPECTION
  templateName String
  content      String // 富文本内容（HTML）
  variables    String? // 使用的变量列表（JSON 数组字符串）
  createdAt    DateTime @default(now())
  version      Int      @default(0) // 乐观锁版本号，更新时校验
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, moduleType]) // 每个业务类型每项目仅一个模板
  @@index([projectId])
}
// ---------------- 采购任务（批次二 · 任务 2.1 采购发起 + 工作流状态） ----------------

model ProcurementTask {
  id          String   @id @default(cuid())
  projectId   String
  taskNo      String // 采购编号：PROC-YYYYMMDD-XXX
  type        String // FRAMEWORK 引用框架协议 | SINGLE 单项采购
  content     String // 采购内容
  purpose     String? // 采购用途
  status      String   @default("NOT_STARTED") // 见 TASK_STATUSES 工作流状态
  stage       Int      @default(0) // 已发布到的阶段序号（0=未发布任何阶段）
  preMeetingRequired Boolean @default(false) // 单项采购：是否需要采前会会议纪要（金额≥100万）
  totalListId String? // 总采购清单 ID（批次二后续任务关联）
  contractId  String? // 生成的合同 ID
  createdAt   DateTime @default(now())
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  totalItems ProcurementTotalItem[]
  frameworkExplanation FrameworkExplanation?

  @@unique([projectId, taskNo])
  @@index([projectId, status])
}

// ---------------- 总采购清单明细（批次二 · 任务 2.2） ----------------

model ProcurementTotalItem {
  id             String  @id @default(cuid())
  projectId      String
  taskId         String
  materialBaseId String // 物资基础库记录（名称/规格只能从基础库选择）
  materialName   String
  spec           String
  unit           String // 计量单位（默认带出，可改为字典值；提交时同步回基础库）
  qty            Float? // 暂定数量
  incomePrice    Float? // 收入单价
  stdCost        Float? // 标准成本
  marketPrice    Float? // 市场单价
  infoPrice      Float? // 信息价
  planPrice      Float? // 预计采购单价（控制价）
  sortOrder      Int     @default(0)
  createdAt      DateTime @default(now())
  version        Int     @default(0)
  updatedAt      DateTime @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    ProcurementTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ---------------- 框架协议事前说明（批次二 · 任务 3.1，仅 FRAMEWORK 类型任务） ----------------

model FrameworkExplanation {
  id               String   @id @default(cuid())
  projectId        String
  taskId           String   @unique // 一个采购任务仅一份事前说明
  frameworkIntro   String? // 一、框架简介（富文本 HTML）
  negotiation      String? // 二、谈判情况（富文本 HTML）
  inquiryRows      String? // 三、询价情况表 JSON: [{rank, unit, totalPrice, taxIncluded, type}]
  priceCompareRows String? // 四、同城/相邻城市局其他单位执行合同价 JSON: [{unit, content, execPrice, note}]
  execution        String? // 五、执行情况（富文本 HTML）
  costRows         String? // 六、成本分析表 JSON: [{item, amount, ratio, note}]
  attachments      String? // 七、附表 JSON: [{fileName, url, size}]
  publishedAt      DateTime? // 发布时间（任务事前说明阶段发布后回填）
  createdAt        DateTime @default(now())
  version          Int      @default(0)
  updatedAt        DateTime @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    ProcurementTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId])
}
