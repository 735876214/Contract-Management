# 依赖与构建产物：镜像内会重新安装/编译，不进构建上下文
node_modules
dist
build
.npm-cache

# 版本控制
.git
.github
.gitignore

# 本地数据库与上传目录：运行时数据落在 /data 卷，不该被 COPY 进镜像
*.db
*.db-journal
dev.db
uploads

# 敏感信息：环境变量一律由 docker-compose 显式注入，
# 绝不能把本地 .env（含 JWT_SECRET 等）打进会公开发布的镜像
.env
.env.*

# 日志与临时文件
*.log
npm-debug.log*
.cache
*.timestamp-*.mjs

# 本地探测 / 调试脚本，运行时不需要
e2e-*.py
test-*.ts
Dockerfile
.dockerignore
